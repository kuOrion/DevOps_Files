# container_prefix scopes every container/volume name for this stack --
# "live-<client_id>" for a live-area client, "staging"/"sanitize" for
# those shared single-slot areas (no client_id -- see DevOps_Files's
# render_client.py --container-prefix). A developer laptop typically just
# passes the bare client_id, since a laptop has no "area" concept at all.
name: {{ container_prefix }}

services:
  db:
    image: postgres:{{ postgres_version }}
    container_name: {{ container_prefix }}-db
    environment:
      POSTGRES_USER: odoo
      POSTGRES_PASSWORD: {{ db_password }}
      POSTGRES_DB: postgres
    volumes:
      - odoo-db-data:/var/lib/postgresql/data
    restart: unless-stopped
    # log_connections/log_disconnections are off by default -- without
    # them Postgres only ever logs FATAL/ERROR-level events (crashes,
    # syntax errors), never a real auth failure or a connection's actual
    # source, which is the entire security gap the postgres/ logging
    # source exists to close (docs/ROADMAP.md, 2026-08-06 logging design).
    # log_min_duration_statement (2026-08-30): logs any query's full text
    # + duration once it exceeds 1000ms -- incidents 06/07 both needed
    # exactly this (which query was slow, not just "a query was slow")
    # and it required live pg_stat_activity capture to find, since
    # nothing logged it. 1s chosen deliberately conservative -- catches
    # genuinely slow queries (the kind that caused real incidents)
    # without logging every mildly-slow-but-ordinary one.
    # Passed as a command-line override, not baked into the image, so it
    # applies uniformly to every client without a per-image rebuild.
    # shared_preload_libraries=pg_stat_statements (2026-08-30): postmaster-
    # context parameter, only takes effect via this command-line/config
    # route (ALTER SYSTEM alone isn't enough) and requires a real restart,
    # same as this whole command list already does. Gives persistent
    # per-query call-count/total-time aggregates that survive across
    # sessions -- complements log_min_duration_statement's per-event
    # slow-query text rather than duplicating it. The `pg_stat_statements`
    # extension object itself still needs `CREATE EXTENSION` per database
    # once this flag is live; not created automatically by this flag alone.
    command: ["postgres", "-c", "log_connections=on", "-c", "log_disconnections=on", "-c", "log_min_duration_statement=1000", "-c", "shared_preload_libraries=pg_stat_statements"]

  web:
    build:
      context: {{ docker_dir }}
      dockerfile: Dockerfile.odoo
      args:
        ODOO_VERSION: "{{ odoo_version }}"
    image: erp16-odoo:{{ odoo_version }}
    container_name: {{ container_prefix }}-web
    depends_on:
      - db
    ports:
      - "127.0.0.1:{{ http_port }}:8069"
      - "127.0.0.1:{{ longpolling_port }}:8072"
    environment:
      HOST: db
      USER: odoo
      PASSWORD: {{ db_password }}
    volumes:
      - odoo-web-data:/var/lib/odoo
      - {{ addons_host_path }}:/mnt/extra-addons
{% if addons_source_path %}
      # --scope-addons mode: addons_host_path above is a directory of
      # symlinks pointing at absolute host paths under addons_source_path
      # (e.g. /home/ubuntu/Live_copy_of_Addons/orion_sales). Those targets
      # only resolve if this exact host path is ALSO reachable inside the
      # container at the same absolute path -- otherwise every symlink is
      # dangling from the container's own mount namespace even though it
      # looks fine from the host (found live, 2026-08-27: Odoo logged
      # "not installable, skipped" for every real installed custom module
      # on puna_eye_care until this second mount was added). Read-only --
      # this mount exists purely so absolute symlink targets resolve, the
      # container should never write through it.
      - {{ addons_source_path }}:{{ addons_source_path }}:ro
{% endif %}
      - {{ config_host_path }}:/etc/odoo
    restart: unless-stopped
{% if dev_mode %}
    # dev_mode MUST be passed as a --dev command-line flag, not an
    # odoo.conf key -- Odoo's config parser unconditionally recomputes
    # self.options['dev_mode'] from the parsed --dev CLI option alone,
    # silently discarding whatever's in the config file (found live,
    # 2026-08-05 -- odoo.conf said dev_mode=reload,qweb,xml but a real
    # `odoo.tools.config['dev_mode']` check inside the running container
    # showed an empty list; the entrypoint script does forward extra args
    # after "odoo" straight through, confirmed via /entrypoint.sh).
    command: ["odoo", "--dev={{ dev_mode }}"]
{% endif %}

volumes:
  odoo-db-data:
  odoo-web-data:
